# Server
PORT=5000
NODE_ENV=development

# MongoDB Atlas
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# Auth (required in production)
JWT_SECRET=replace-with-a-long-random-secret

# Public URLs (used for gallery/activity image URLs in API responses)
# Local dev:
BACKEND_URL=http://localhost:5000
# Production (Render) — required; never use localhost:
# BACKEND_URL=https://tpo-website-631h.onrender.com
FRONTEND_URL=http://localhost:5173

# Cloudinary (required for gallery uploads in development and production)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
